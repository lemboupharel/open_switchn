# Copy to .env and chmod 600. npm run web/cli load .env automatically.
# Live-only compatibility settings: mock/false values are rejected.
SWITCHN_MODE=live
SWITCHN_ENABLE_LIVE=true
SWITCHN_ALLOW_PAYMENTS=false
SWITCHN_APP_VERSION=4.1.2
SWITCHN_USER_AGENT=switchn-local-client/0.1
SWITCHN_FCM_TOKEN=
SWITCHN_BEARER_TOKEN=
# Client configuration for the authorized Switchn Firebase project, not a bearer token.
# Do not use a different project's key or bypass Android-only key restrictions.
SWITCHN_FIREBASE_API_KEY=
# In-memory sanitized traces only; CLI prints them to stderr when enabled.
SWITCHN_DEBUG=false
SWITCHN_TIMEOUT_MS=15000
SWITCHN_PORT=4317
# Optional absolute directory; live state is stored in its live/ subdirectory.
# SWITCHN_DATA_DIR=/absolute/private/path
# Explicit, verified payment hosts only, comma separated. No wildcards.
SWITCHN_PAYMENT_HOSTS=
